# Process environment only; .NET does not autoload .env. Never commit real credentials.
# Empty namespace + false opt-in are intentionally non-runnable.
MONGO_URI=
MONGO_ALLOWED_HOST=
MONGO_DATABASE=
MONGO_COLLECTION_PREFIX=
MONGO_AUTH_MODE=scram
MONGO_USERNAME=
MONGO_PASSWORD=
ALLOW_DATABASE_WRITES=false
VECTOR_DATA_FILE=data/Hotels_Vector.json
QUERY_VECTOR_FILE=data/query-vector.json
VectorSearch__TopK=5
OPERATION_TIMEOUT_SECONDS=300
